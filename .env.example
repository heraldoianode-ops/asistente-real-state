# --- WhatsApp Cloud API (Meta) — YA IMPLEMENTADO, solo credenciales ---
WA_TOKEN=                            # token permanente (System User) de Meta
WA_PHONE_NUMBER_ID=                  # ID del número emisor
WA_VERIFY_TOKEN=                     # string que inventás vos (verificación webhook)
WHATSAPP_APP_SECRET=                 # secreto de la App de Meta (valida firmas)
WA_API_VERSION=v21.0
WHATSAPP_GATEWAY_URL=                # URL pública del gateway (para edge functions)
NEXT_PUBLIC_WHATSAPP_GW_URL=http://localhost:3001

# --- Google Calendar (OAuth por agente) — Fase 1, requiere código nuevo ---
