# ============================================================
# Asistente Real State — variables de entorno (ejemplo)
# ES: Copiá a .env y completá. Las secretas NUNCA se commitean.
# EN: Copy to .env and fill in. Secrets are NEVER committed.
#
# Destinos de despliegue / Deploy targets:
#   [NETLIFY]  → dashboard Next.js (Site settings → Environment variables)
#   [RAILWAY-BACKEND] → servicios Python: backend (web) + celery-worker + celery-beat
#   [RAILWAY-GATEWAY] → servicio Node del gateway de WhatsApp
#   [SUPABASE-EDGE]   → supabase secrets set KEY=value (Edge Functions)
# Los nombres acá son los que el CÓDIGO realmente lee (pydantic-settings /
# process.env). No renombrar sin tocar el código.
# ============================================================

# ------------------------------------------------------------
# [NETLIFY] Dashboard (Next.js) — solo estas NEXT_PUBLIC_*
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://nehfrtedwcmdlmbulhef.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_PVLt7BxiUrezs3WigUDGJg_Ot-e1zf9
NEXT_PUBLIC_WHATSAPP_GW_URL=http://localhost:3001

# ------------------------------------------------------------
# [RAILWAY-BACKEND] backend + celery-worker + celery-beat
# (pydantic-settings, case-insensitive)
# ------------------------------------------------------------
# --- Base de datos: Supabase Session pooler (puerto 5432, driver asyncpg) ---
DATABASE_URL=postgresql+asyncpg://postgres.nehfrtedwcmdlmbulhef:<DB_PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_SCHEMA=asistente_real_state

# --- Supabase ---
SUPABASE_URL=https://nehfrtedwcmdlmbulhef.supabase.co
SUPABASE_ANON_KEY=sb_publishable_PVLt7BxiUrezs3WigUDGJg_Ot-e1zf9
SUPABASE_SERVICE_ROLE_KEY=           # secreto — solo backend, nunca al cliente
SUPABASE_JWT_SECRET=                 # secreto

# --- Redis (add-on de Railway) ---
REDIS_URL=redis://default:<PASSWORD>@<HOST>:<PORT>

# --- IA / LLM (en prod usar anthropic u openai; local = Ollama solo dev) ---
AI_POLICY=anthropic                  # local | anthropic | openai
ANTHROPIC_API_KEY=                   # secreto (si AI_POLICY=anthropic)
OPENAI_API_KEY=                      # secreto (si AI_POLICY=openai)
OLLAMA_BASE_URL=http://ollama:11434  # solo dev local
OLLAMA_MODEL=llama3                  # solo dev local

# --- Auth local heredada (FastAPI valida JWT) ---
JWT_SECRET=                          # secreto, min 32 chars

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=                      # secreto — token permanente (System User)
WHATSAPP_PHONE_NUMBER_ID=            # ID del número emisor
WHATSAPP_VERIFY_TOKEN=               # secreto — string que inventás vos
WHATSAPP_APP_SECRET=                 # secreto — valida firmas de Meta

# --- Google Drive (sync de documentos) ---
GOOGLE_SERVICE_ACCOUNT_JSON=         # secreto (JSON de service account)
GOOGLE_DRIVE_FOLDER_ID=

# --- Email (Resend) ---
RESEND_API_KEY=                      # secreto
RESEND_FROM_EMAIL=noreply@example.com

# --- Observabilidad / CORS ---
SENTRY_DSN=
CORS_ORIGINS=["https://solernou.netlify.app"]   # dominio(s) del dashboard

# --- Adinco (Fase 3, scraping autenticado) ---
ADINCO_USERNAME=
ADINCO_PASSWORD=                     # secreto

# ------------------------------------------------------------
# [RAILWAY-GATEWAY] gateway Node de WhatsApp (process.env.*)
# ------------------------------------------------------------
WHATSAPP_TOKEN=                      # secreto (mismo valor que backend)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=               # secreto (mismo valor que el webhook de Meta)
WHATSAPP_APP_SECRET=                 # secreto
FASTAPI_URL=http://<backend-railway-internal>:8000   # sin barra final
REDIS_URL=redis://default:<PASSWORD>@<HOST>:<PORT>
GATEWAY_PORT=3000                    # Railway inyecta $PORT
GATEWAY_INTERNAL_SECRET=             # secreto
RL_MAX_MESSAGES=20                   # opcional — rate limit
RL_WINDOW_SECONDS=60                 # opcional — ventana de rate limit

# ------------------------------------------------------------
# [SUPABASE-EDGE] supabase secrets set KEY=value
# (Google Calendar OAuth — Fase 1; SUPABASE_URL/SERVICE_ROLE ya inyectados)
# ------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=          # secreto
GOOGLE_OAUTH_REDIRECT_URI=https://nehfrtedwcmdlmbulhef.supabase.co/functions/v1/google-oauth-callback
WHATSAPP_GATEWAY_URL=                # URL pública del gateway (para edge functions)
