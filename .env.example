# ─── DATABASE (Supabase) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── OLLAMA (local-first LLM) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ─── AI POLICY (local | anthropic | openai) ──────────────────────────────────
AI_POLICY=local

# ─── ANTHROPIC (optional, only if AI_POLICY=anthropic) ───────────────────────
ANTHROPIC_API_KEY=

# ─── OPENAI (optional, only if AI_POLICY=openai) ─────────────────────────────
OPENAI_API_KEY=

# ─── WHATSAPP (Meta Cloud API) ───────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=changeme_verify
WHATSAPP_APP_SECRET=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── GOOGLE DRIVE ────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ─── EMAIL (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── SENTRY ──────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── GATEWAY ─────────────────────────────────────────────────────────────────
FASTAPI_URL=http://backend:8000
GATEWAY_PORT=3000

# ─── RATE LIMIT ──────────────────────────────────────────────────────────────
RL_MAX_MESSAGES=10
RL_WINDOW_SECONDS=60

# ─── ADMIN ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=changeme_admin
