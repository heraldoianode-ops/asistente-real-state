# Supabase (required — dashboard uses supabase-js directly since Fase 8)
# ES: Valores en Supabase → Project Settings → API Keys. Usar la key "publishable" (sb_publishable_...);
#     la anon key legacy (JWT) está deshabilitada en este proyecto.
# EN: Values in Supabase → Project Settings → API Keys. Use the "publishable" key (sb_publishable_...);
#     the legacy anon JWT key is disabled for this project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public env (accessible in browser)
NEXT_PUBLIC_APP_NAME=Asistente Real State

# WhatsApp webhook (Netlify Function — no Hetzner needed)
NEXT_PUBLIC_WHATSAPP_GW_URL=https://solernou.netlify.app/api/whatsapp-webhook
